APP_NAME=mCMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=bg
APP_FALLBACK_LOCALE=bg

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# bcrypt by default; set HASH_DRIVER=argon2id if your PHP supports it
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Comma separated IPs, or * when behind Cloudflare / a reverse proxy
TRUSTED_PROXIES=

# mCMS
# One-time key asked by the web installer (auto-generated on first run, removed after install)
MCMS_INSTALL_KEY=
MCMS_ADMIN_PATH=panel
# Admin/installer interface language: en (default) or bg. Switch anytime with ?lang=bg
MCMS_ADMIN_LOCALE=en
MCMS_ADMIN_IDLE_MINUTES=30
MCMS_MAX_UPLOAD_MB=8
MCMS_MAX_VIDEO_MB=30
