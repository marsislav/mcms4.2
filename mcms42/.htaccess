# Use this file ONLY when the document root is the project root (e.g. public_html).
# Best practice: point the document root to /public instead and delete this file.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose application internals
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|artisan|README\.md|storage|vendor|app|bootstrap|config|database|resources|routes|plugins|lang|tests)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
