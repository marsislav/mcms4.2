# Uploads are DATA, never code.
Options -ExecCGI -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block every executable / server-parsed extension, even if one slips through
<FilesMatch "(?i)\.(php[0-9]*|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|shtml|htaccess|htpasswd|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>

# PDFs need the browser viewer: relax the sandbox for them only
<FilesMatch "(?i)\.pdf$">
    <IfModule mod_headers.c>
        Header always unset Content-Security-Policy
        Header always set Content-Disposition "inline"
    </IfModule>
</FilesMatch>

# WebM / MP4 backgrounds: no sandbox CSP (it would block playback when opened directly)
<FilesMatch "(?i)\.(webm|mp4)$">
    <IfModule mod_headers.c>
        Header always unset Content-Security-Policy
    </IfModule>
</FilesMatch>

# Only these types may be served
<IfModule mod_mime.c>
    AddType video/webm .webm
    AddType video/mp4 .mp4
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
    RemoveType .php .phtml
</IfModule>
